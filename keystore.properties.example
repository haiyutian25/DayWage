# 复制为 keystore.properties（已被 .gitignore 忽略）即可给 release 包签名。
#
# 生成密钥库（只需一次，生成后务必另行备份，丢了就无法再更新同一个包名）：
#   keytool -genkeypair -v -keystore daywage-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias daywage
storeFile=daywage-release.jks
storePassword=change-me
keyAlias=daywage
keyPassword=change-me
